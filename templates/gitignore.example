# Whitelist: ignore everything at the root (the game install lives here), then re-include only our work.
# Never stage game binaries, PDBs, cooked assets, Ghidra databases, venvs, downloads or secrets.
/*

!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/.mcp.json
!/.claude/
!/_prompts/
!/_tools/
!/_re/
!/docs/
!/tracking/
!/src/
!/tests/
!/side-projects/
# NOTE: no "tools/" — on Windows it is the same folder as the game's own Tools\ directory.
# Our rebuild helpers live in _tools/rebuild/ instead (see CLAUDE.md).

# _tools: keep our scripts and grid configs; drop third-party installs, caches, downloads, secrets
/_tools/downloads/
/_tools/ghidra_*_PUBLIC/
/_tools/jdk-*/
/_tools/steamcmd/
/_tools/ghidra-mcp-venv/
/_tools/uv-bootstrap/
/_tools/uv-cache/
/_tools/uv-python/
/_tools/server.local.json
/_tools/grids/**/*.jpg
/_tools/grids/**/*.png

# _re: Ghidra DBs are rebuildable from binary + PDB + annotations + src/sdk headers
/_re/ghidra/
/_re/ghidra-client/
/_re/ghidra-bulk/
/_re/ghidra-client-bulk/
/_re/ghidra-devkit/
/_re/ghidra-delink/
# bulk decompile corpus: searchable reference, regenerated by _tools/ghidra_bulk_export.py
/_re/corpus/
/_re/inventory/*
!/_re/inventory/README.md
!/_re/inventory/*.py
!/_re/inventory/summary*.md
# large traces are summarized in docs instead
/_re/logs/frida-loadmap.txt
/_re/logs/*.log
# perf recordings (CSV, MB per minute); findings are summarised in docs/knowledge/perf-recorder.md
/_re/perf/
# caches of the matching judge (PDB publics / contributions, rebuilt from the PDB by _tools/func_match.py)
/_re/cache/

# Node services: dependencies, build output, local secrets
/src/services/*/node_modules/
/src/services/*/dist/
/src/services/*/.env
/src/services/*/.env.*

# Claude Code local settings
/.claude/settings.local.json

# build output and Python noise
/build/
__pycache__/
*.pyc
